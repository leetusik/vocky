# Production secrets template for the vocky.hi2vi.com box (P6.S5).
#
# Copy this to `.env` ON THE BOX (never commit the real `.env` — it is gitignored)
# and fill in the three secrets below. compose.prod.yml reads them as `${...}`
# interpolations; there is NO `env_file:` in the compose, so ONLY these three vars
# are secrets — everything else in compose.prod.yml is a committed literal.
#
# Generate each secret ON THE BOX, e.g.:
#   openssl rand -base64 32

# Postgres password for the `vocky` control-plane database. Consumed by the postgres
# service (POSTGRES_PASSWORD) AND baked into the api/worker DATABASE_URL. Rotating it
# requires also updating the stored password in the postgres volume.
POSTGRES_PASSWORD=

# Session-cookie signing/encryption secret for the web BFF (AES-256-GCM key derive).
# Web service only. Rotating it invalidates every live session — all users re-login.
SESSION_SECRET=

# Bearer that guards the api's surviving /admin/api REST surface. Api service only.
VOCKY_ADMIN_AUTH_TOKEN=

# --- NOT set here (documented so nobody adds them by mistake) ---
# DATABASE_URL / REDIS_URL / VOCKY_API_BASE_URL are LITERAL container-name URLs
#   hard-coded in compose.prod.yml (they reference the fixed container names over the
#   shared network) — they are not secrets and do not belong in `.env`.
# NEXT_PUBLIC_APP_URL is a compose BUILD ARG (web service build.args =
#   https://vocky.hi2vi.com), inlined into the web bundle at build time — not runtime,
#   not a secret, not here.
