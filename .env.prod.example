# Production secrets template for the vocky.hi2vi.com box (P6.S5).
#
# Copy this to `.env` ON THE BOX (never commit the real `.env` — it is gitignored)
# and fill in the four secrets below, plus the SMTP config block. compose.prod.yml
# reads them as `${VAR:?err}` / `${VAR:-default}` interpolations; there is NO
# `env_file:` in the compose, so ONLY these vars are secrets/config — everything
# else in compose.prod.yml is a committed literal.
#
# FOUR SECRETS ARE REQUIRED (POSTGRES_PASSWORD, SESSION_SECRET,
# VOCKY_ADMIN_AUTH_TOKEN, VOCKY_SMTP_PASSWORD), plus VOCKY_SMTP_HOST/VOCKY_SMTP_USER
# which are required but not secret. Each uses the `:?` form, so a missing or blank
# value now ABORTS `docker compose` (config/up/etc.) with an actionable error instead
# of silently degrading — see compose.prod.yml's header comment. The remaining SMTP
# vars (VOCKY_SMTP_PORT, VOCKY_SMTP_FROM) are optional config with defaults.
#
# Generate each secret ON THE BOX, e.g.:
#   openssl rand -base64 32

# REQUIRED. Postgres password for the `vocky` control-plane database. Consumed by the
# postgres service (POSTGRES_PASSWORD) AND baked into the api/worker DATABASE_URL.
# Rotating it requires also updating the stored password in the postgres volume.
POSTGRES_PASSWORD=

# REQUIRED. Session-cookie signing/encryption secret for the web BFF (AES-256-GCM key
# derive). Web service only. Rotating it invalidates every live session — all users
# re-login.
SESSION_SECRET=

# REQUIRED. Bearer that guards the api's surviving /admin/api REST surface. Api
# service only. Without it, AdminBearerAuthMiddleware refuses every /admin/api/*
# request with 503 (fail closed) — it never falls back to an unauthenticated surface.
VOCKY_ADMIN_AUTH_TOKEN=

# SMTP transport for feedback email alerts (P13). Worker service only — the api
# never sends. These are copied from the SMTP account changple5 already uses in
# production; read them out of changple5's env on the box at bring-up (see
# P13.S5's runbook for the exact mapping). Feedback alerts go to each org owner's
# account email — no per-user configuration exists yet.

# REQUIRED. SMTP server hostname the worker connects to.
VOCKY_SMTP_HOST=

# REQUIRED. SMTP account username the worker authenticates with.
VOCKY_SMTP_USER=

# REQUIRED. SMTP account password — the SECRET. Worker service only.
VOCKY_SMTP_PASSWORD=

# Optional. SMTP server port. Defaults to 587 (STARTTLS) when unset.
VOCKY_SMTP_PORT=

# Optional. From address for feedback alert emails. Defaults to VOCKY_SMTP_USER
# when unset.
VOCKY_SMTP_FROM=

# --- NOT set here (documented so nobody adds them by mistake) ---
# DATABASE_URL / REDIS_URL / VOCKY_API_BASE_URL are LITERAL container-name URLs
#   hard-coded in compose.prod.yml (they reference the fixed container names over the
#   shared network) — they are not secrets and do not belong in `.env`.
# NEXT_PUBLIC_APP_URL is a compose BUILD ARG (web service build.args =
#   https://vocky.hi2vi.com), inlined into the web bundle at build time — not runtime,
#   not a secret, not here.
