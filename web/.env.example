# vocky-web environment (P4.S2). Copy to `.env.local` and fill in.
#
# The two keys below are SERVER-ONLY — neither is NEXT_PUBLIC_, and both are read
# through `src/lib/env.ts`, which is `import "server-only"`. They must never be
# exposed to the browser: the whole point of the BFF (D-P4-2) is that only the
# Next.js server talks to vocky, and the session key never leaves it. The one
# NEXT_PUBLIC_ var (the public origin, at the bottom) is deliberately browser-safe.

# Base URL of the vocky API the Next.js server calls server-to-server.
# Local dev: http://127.0.0.1:8000
VOCKY_API_BASE_URL=

# Secret the AES-256-GCM session key is derived from (sha256 of this value) to
# seal vocky's bearer token into the httpOnly cookie. Use a long random string,
# e.g. `openssl rand -base64 32`. Rotating it invalidates every live session
# (all users are forced to sign in again).
SESSION_SECRET=

# PUBLIC absolute origin of the deployed site, baked in at BUILD time (it is
# NEXT_PUBLIC_, so it is inlined into the client bundle — safe, it's just the
# public URL). Drives `metadataBase`, canonical/OG URLs, robots/sitemap/manifest.
# Local dev: leave blank → SITE.url falls back to http://127.0.0.1:3030.
# Production: set to https://vocky.hi2vi.com via the Docker `build.args` (P6.S4/S5).
NEXT_PUBLIC_APP_URL=
