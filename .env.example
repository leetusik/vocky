DATABASE_URL=postgresql+psycopg://vocky:vocky@127.0.0.1:55432/vocky
REDIS_URL=redis://127.0.0.1:56379/0
# TEST_DATABASE_URL must point at a separate disposable database.
TEST_DATABASE_URL=postgresql+psycopg://vocky:vocky@127.0.0.1:55432/vocky_test
VOCKY_HOST=0.0.0.0
VOCKY_PORT=8000
VOCKY_LOG_LEVEL=INFO
# Optional HTTP user agent for health and smoke checks through external proxies.
# VOCKY_HTTP_USER_AGENT=VockySmoke/0.1
VOCKY_PUBLISH_HOST=127.0.0.1
# Optional when the smoke-check base URL differs from http://127.0.0.1:${VOCKY_PORT}
# VOCKY_BASE_URL=http://127.0.0.1:8000

# Optional external access URL for Cloudflare Tunnel or another HTTPS reverse proxy.
# Set this before running `make external-smoke` or `make external-verify`.
# Public custom-domain example:
# VOCKY_EXTERNAL_BASE_URL=https://vocky.example.com
# Public REST capture (/api/*) requires a per-project credential minted via
# POST /app/projects/{id}/credentials; there is no global capture token.
# Optional bearer token required for Admin REST traffic. Set this before exposing /admin/api.
# VOCKY_ADMIN_AUTH_TOKEN=replace-with-a-different-long-random-secret
# Directory where feedback image attachments are stored (local filesystem backend).
# In Docker this is a named volume mounted on both app and worker.
VOCKY_ATTACHMENTS_DIR=./attachments
# Maximum size in bytes for a single uploaded attachment (default 5 MiB).
VOCKY_ATTACHMENTS_MAX_BYTES=5242880
# Maximum number of attachments that may be linked to one feedback event.
VOCKY_ATTACHMENTS_MAX_COUNT=10
# Comma-separated allowed attachment MIME types (validated by magic-byte sniffing).
VOCKY_ATTACHMENTS_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp
POSTGRES_DB=vocky
POSTGRES_USER=vocky
POSTGRES_PASSWORD=vocky
POSTGRES_PORT=55432
POSTGRES_PUBLISH_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PUBLISH_HOST=127.0.0.1
