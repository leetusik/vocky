DATABASE_URL=postgresql+psycopg://vocky:vocky@127.0.0.1:55432/vocky
REDIS_URL=redis://127.0.0.1:56379/0
# TEST_DATABASE_URL must point at a separate disposable database.
TEST_DATABASE_URL=postgresql+psycopg://vocky:vocky@127.0.0.1:55432/vocky_test
VOCKY_HOST=0.0.0.0
VOCKY_PORT=8000
VOCKY_LOG_LEVEL=INFO
# Optional HTTP user agent for health and smoke checks through external proxies.
# VOCKY_HTTP_USER_AGENT=VockySmoke/0.1
VOCKY_PUBLISH_HOST=127.0.0.1
# Optional when the smoke-check base URL differs from http://127.0.0.1:${VOCKY_PORT}
# VOCKY_BASE_URL=http://127.0.0.1:8000

# Optional external access URL for Tailscale Serve, Cloudflare Tunnel, or another reverse proxy.
# Tailscale example:
# VOCKY_EXTERNAL_BASE_URL=https://<your-node>.<your-tailnet>.ts.net
#
# Public custom-domain example through Cloudflare Tunnel or another HTTPS proxy:
# VOCKY_EXTERNAL_BASE_URL=https://vocky.example.com
# Comma-separated public Host headers allowed for MCP DNS rebinding protection.
# VOCKY_MCP_ALLOWED_HOSTS=vocky.example.com
# Comma-separated browser Origin headers allowed for MCP requests.
# VOCKY_MCP_ALLOWED_ORIGINS=https://vocky.example.com
# Optional bearer token required for MCP traffic. Set this before public exposure.
# VOCKY_MCP_AUTH_TOKEN=replace-with-a-long-random-secret
# Optional bearer token required for public REST capture traffic. Set this before exposing /api.
# VOCKY_API_AUTH_TOKEN=replace-with-another-long-random-secret
# Optional bearer token required for Admin REST traffic. Set this before exposing /admin/api.
# VOCKY_ADMIN_AUTH_TOKEN=replace-with-a-different-long-random-secret
POSTGRES_DB=vocky
POSTGRES_USER=vocky
POSTGRES_PASSWORD=vocky
POSTGRES_PORT=55432
POSTGRES_PUBLISH_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_PUBLISH_HOST=127.0.0.1
